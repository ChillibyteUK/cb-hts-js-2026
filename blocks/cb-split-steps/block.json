{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-hts-js-2026/cb-split-steps",
	"title": "CB Split Steps",
	"category": "cb-hts-js-2026",
	"icon": "columns",
	"description": "Sticky headline/copy column beside a numbered list of steps with optional links, and an optional scroll watermark.",
	"attributes": {
		"eyebrow": { "type": "string", "default": "" },
		"headline": { "type": "string", "default": "" },
		"body": { "type": "string", "default": "" },
		"steps": { "type": "array", "default": [] },
		"watermark": { "type": "string", "default": "" }
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": true,
		"color": {
			"background": true
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
