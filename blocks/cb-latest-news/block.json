{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-hts-js-2026/cb-latest-news",
	"title": "CB Latest News",
	"category": "cb-hts-js-2026",
	"icon": "megaphone",
	"description": "The three most recent Insights posts as cards (a slider on mobile), with a title and a right-aligned 'See all' button.",
	"attributes": {
		"headline": { "type": "string", "default": "" },
		"buttonText": { "type": "string", "default": "" },
		"buttonUrl": { "type": "string", "default": "" },
		"buttonTarget": { "type": "boolean", "default": false }
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": true,
		"color": {
			"background": true
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
